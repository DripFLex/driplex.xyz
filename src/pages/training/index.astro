---
import Layout from '../../layouts/Layout.astro';
import SessionCard from '../../components/SessionCard.astro';
import { sessions, filterSessions, sportStats, calendar, fullDateLabel, durationLabel, DEMO_TODAY } from '../../lib/data';
import '../../styles/training.css';
const initial = filterSessions(sessions, 2026);
const stats = sportStats(initial);
const days = calendar(sessions, 2026);
const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
const latestDay = initial[0]?.date ?? DEMO_TODAY;
const activeDays = days.filter(day=>day.minutes>0).length;
---
<Layout title="Training" description="The DRIPLEX demo training journal. Running, strength and a year of movement.">
 <div class="page-heading training-heading"><div><p class="eyebrow">TRAINING / MOVEMENT DAY BY DAY</p><h1>Show up.<br/><em>Keep moving.</em></h1><p class="lead">Miles and reps. A record of the small efforts that add up.</p></div><div class="training-heading-note"><span class="training-pulse" aria-hidden="true"></span> THE TRAINING JOURNAL<span>Running & Strength</span></div></div>
 <p class="demo-notice">Demo — all activities are fictional. Dates are fixed relative to 29 October 2026. No Garmin or Strava connection.</p>
 <section class="training-annual" aria-labelledby="annual-title">
  <div class="training-toolbar"><div><p class="eyebrow">CONSISTENCY AT A GLANCE</p><h2 id="annual-title">A year in motion</h2></div><label class="year-control" hidden>Year <select id="training-year" aria-label="Calendar year">{[2024,2025,2026,2027].map(year=><option selected={year===2026} value={year}>{year}</option>)}</select></label></div>
  <div class="training-controls" hidden><div class="training-filters" role="group" aria-label="Discipline"><button type="button" data-filter="All" aria-pressed="true">All</button><button type="button" data-filter="Running" aria-pressed="false">Running</button><button type="button" data-filter="Strength" aria-pressed="false">Strength</button></div><p id="graph-summary" role="status" aria-live="polite">{initial.length} sessions · {activeDays} active days · 2026</p></div>
  <p id="graph-instructions" class="sr-only">Calendar: use the up and down arrows to move by day, and left and right to move by week. Press Enter or Space to view sessions. Future days are disabled.</p>
  <div class="contribution-scroll" tabindex="0" role="region" aria-label="Horizontally scrollable yearly calendar"><div class="contribution-content"><div class="contribution-months" aria-hidden="true">{months.map((month,index)=>{const day=days.find(day=>day.date===`2026-${String(index+1).padStart(2,'0')}-01`);return <span style={`grid-column:${(day?.week??0)+1}`}>{month}</span>;})}</div><div class="contribution-body"><div class="contribution-weekdays" aria-hidden="true">{['Mon','','Wed','','Fri','',''].map(day=><span>{day}</span>)}</div><div id="contribution-grid" class="contribution-grid" role="group" aria-label="Days in 2026" aria-describedby="graph-instructions">{days.map(day=>day.outside?<span class="contribution-padding" aria-hidden="true"></span>:<button type="button" class="contribution-day" data-date={day.date} data-level={day.level} disabled={day.future} tabindex={day.date===latestDay?0:-1} aria-pressed={day.date===latestDay} aria-label={`${fullDateLabel(day.date)} : ${day.future?'future date':`${day.activities.length} session(s), ${day.minutes} minutes, demo`}`} title={`${fullDateLabel(day.date)} · ${day.future?'Future date':`${day.minutes} min · ${day.activities.length} fictional session(s)`}`}></button>)}</div></div></div></div>
  <div class="contribution-footer"><p id="day-preview">{fullDateLabel(latestDay)} · Select a day to view sessions.</p><div class="contribution-legend"><span>Less</span>{[0,1,2,3,4].map(level=><span class="legend-cell" data-level={level} title={['0 min','1–29 min','30–59 min','60–89 min','90 min or more'][level]}></span>)}<span>More</span></div></div>
  <label class="training-date-control" hidden>View a day <input id="training-date" type="date" min="2026-01-01" max={DEMO_TODAY} value={latestDay}/></label>
  <p class="training-fineprint">Colors show total duration: 0 · 1–29 · 30–59 · 60–89 · 90+ min. This is not a measure of physiological training load. Future days are unavailable.</p>
 </section>
 <section class="day-detail-panel" aria-labelledby="day-title"><div class="section-heading"><h2 id="day-title">{fullDateLabel(latestDay)}</h2><span class="eyebrow">DAY DETAILS · FICTIONAL</span></div><div id="day-details" aria-live="polite">{initial.filter(session=>session.date===latestDay).map(session=><SessionCard session={session}/>)}</div></section>
 <section class="training-overview" aria-labelledby="overview-title"><div class="section-heading"><h2 id="overview-title">The overview <span id="stats-year">2026</span></h2><span id="stats-scope" class="eyebrow">ALL · DEMO</span></div><div class="training-stat-grid"><article class="training-stat"><p class="eyebrow">RUNNING DISTANCE</p><strong><span data-stat="running-km">{stats.running.km.toLocaleString('en-GB')}</span><small> km</small></strong><p><span data-stat="running-count">{stats.running.count}</span> runs · <span data-stat="running-duration">{durationLabel(stats.running.minutes)}</span></p></article><article class="training-stat"><p class="eyebrow">STRENGTH SESSIONS</p><strong data-stat="strength-count">{stats.strength.count}</strong><p><span data-stat="strength-duration">{durationLabel(stats.strength.minutes)}</span> in total</p></article><article class="training-stat"><p class="eyebrow">TIME IN MOTION</p><strong data-stat="all-duration">{durationLabel(stats.all.minutes)}</strong><p><span data-stat="all-count">{stats.all.count}</span> sessions · all fictional</p></article></div><div class="training-sport-details"><article><h3>Running</h3><p>Latest run: <span data-stat="running-latest">{stats.running.latest?`${stats.running.latest.title} · ${fullDateLabel(stats.running.latest.date)}`:'No sessions'}</span></p><p>Personal records: <span data-stat="running-records">Not recorded</span></p></article><article><h3>Strength</h3><p>Latest session: <span data-stat="strength-latest">{stats.strength.latest?`${stats.strength.latest.title} · ${fullDateLabel(stats.strength.latest.date)}`:'No sessions'}</span></p><p>Exercises: <span data-stat="strength-exercises">{stats.strength.exercises.join(', ')||'Not recorded'}</span></p></article></div></section>
 <section class="section training-journal"><div class="section-heading"><h2>The activity journal</h2><span id="session-count" role="status" aria-live="polite">{initial.length} demo sessions</span></div><div id="sessions">{sessions.map(session=><div class="journal-entry" data-date={session.date} data-sport={session.sport} hidden={!initial.includes(session)}><SessionCard session={session}/></div>)}</div><p id="journal-empty" hidden>No sessions for this year and discipline.</p><noscript><p>Without JavaScript, the 2026 overview and its session cards remain available. Filters and other years require JavaScript.</p></noscript></section>
</Layout>
<script>
 import { calendar, filterSessions, sportStats, fullDateLabel, durationLabel, paceLabel, DEMO_TODAY } from '../../lib/training';
 import type { Discipline, Session } from '../../lib/data';
 import rawSessions from '../../data/sessions.json';
 const sessions=(rawSessions as Session[]).sort((a,b)=>b.date.localeCompare(a.date)||a.id.localeCompare(b.id));
 let year=2026;
 let discipline:Discipline='All';
 let selected=filterSessions(sessions,year)[0]?.date??DEMO_TODAY;
 const grid=document.querySelector<HTMLElement>('#contribution-grid')!;
 const buttons=document.querySelectorAll<HTMLButtonElement>('[data-filter]');
 const yearSelect=document.querySelector<HTMLSelectElement>('#training-year')!;
 const dayDetails=document.querySelector<HTMLElement>('#day-details')!;
 const months=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
 const dateInput=document.querySelector<HTMLInputElement>('#training-date')!;
 document.querySelectorAll<HTMLElement>('.training-controls,.year-control,.training-date-control').forEach(el=>el.hidden=false);
 function text(selector:string,value:string){const element=document.querySelector(selector);if(element)element.textContent=value;}
 function sessionDescription(session:Session){return `${session.sport} · ${session.minutes} min${session.sport==='Running'&&session.km?` · ${session.km.toLocaleString('en-GB')} km · ${paceLabel(session)}`:''}`;}
 function showDay(date:string){
  selected=date;dateInput.value=date;
  grid.querySelectorAll<HTMLButtonElement>('.contribution-day').forEach(button=>{button.setAttribute('aria-pressed',String(button.dataset.date===date));button.tabIndex=button.dataset.date===date?0:-1;});
  text('#day-title',fullDateLabel(date));
  const activities=filterSessions(sessions,year,discipline).filter(session=>session.date===date);
  dayDetails.replaceChildren();
  if(!activities.length){const empty=document.createElement('p');empty.className='training-empty';empty.textContent=date>DEMO_TODAY?'This date is in the future. No training recorded.':'No sessions for this day and filter. Rest is part of the journey too.';dayDetails.append(empty);return;}
  activities.forEach(session=>{
   const article=document.createElement('article');article.className='daily-activity';
   const meta=document.createElement('p');meta.className='eyebrow';meta.textContent=`${sessionDescription(session)} · DEMO`;
   const heading=document.createElement('h3');const link=document.createElement('a');link.href=`/training/${session.id}/`;link.textContent=session.title;heading.append(link);article.append(meta,heading);
   if(session.sport==='Strength'&&session.exercises?.length){const list=document.createElement('ul');session.exercises.forEach(exercise=>{const item=document.createElement('li');item.textContent=`${exercise.name} · ${exercise.sets} × ${exercise.reps?`${exercise.reps} reps`:`${exercise.seconds} s`}${exercise.kg!==undefined?` · ${exercise.kg} kg`:' · weight not recorded'}`;list.append(item);});article.append(list);}
   if(session.note){const note=document.createElement('p');note.textContent=session.note;article.append(note);}
   dayDetails.append(article);
  });
 }
 function render(){
  const filtered=filterSessions(sessions,year,discipline);
  const days=calendar(sessions,year,DEMO_TODAY,discipline);
  grid.setAttribute('aria-label',`Days in ${year}`);
  grid.replaceChildren();
  days.forEach(day=>{
   if(day.outside){const padding=document.createElement('span');padding.className='contribution-padding';padding.setAttribute('aria-hidden','true');grid.append(padding);return;}
   const button=document.createElement('button');button.type='button';button.className='contribution-day';button.dataset.date=day.date;button.dataset.level=String(day.level);button.disabled=day.future;button.tabIndex=-1;
   const description=`${fullDateLabel(day.date)} : ${day.future?'future date':`${day.activities.length} session(s), ${day.minutes} minutes, demo`}`;button.setAttribute('aria-label',description);button.title=description;button.setAttribute('aria-pressed','false');
   const preview=()=>text('#day-preview',description);
   button.addEventListener('mouseenter',preview);button.addEventListener('focus',preview);button.addEventListener('click',()=>showDay(day.date));grid.append(button);
  });
  const monthRow=document.querySelector('.contribution-months')!;monthRow.replaceChildren();
  months.forEach((month,index)=>{const item=document.createElement('span');item.textContent=month;item.style.gridColumn=String((days.find(day=>day.date===`${year}-${String(index+1).padStart(2,'0')}-01`)?.week??0)+1);monthRow.append(item);});
  if(!selected.startsWith(`${year}-`)||selected>DEMO_TODAY)selected=filtered[0]?.date??`${year}-01-01`;
  dateInput.min=`${year}-01-01`;dateInput.max=year<Number(DEMO_TODAY.slice(0,4))?`${year}-12-31`:DEMO_TODAY;dateInput.disabled=year>Number(DEMO_TODAY.slice(0,4));
  showDay(selected);
  const stats=sportStats(filtered);
  const data:Record<string,string>={'running-km':stats.running.km.toLocaleString('en-GB'),'running-count':String(stats.running.count),'running-duration':durationLabel(stats.running.minutes),'strength-count':String(stats.strength.count),'strength-duration':durationLabel(stats.strength.minutes),'all-duration':durationLabel(stats.all.minutes),'all-count':String(stats.all.count),'running-latest':stats.running.latest?`${stats.running.latest.title} · ${fullDateLabel(stats.running.latest.date)}`:'No sessions','strength-latest':stats.strength.latest?`${stats.strength.latest.title} · ${fullDateLabel(stats.strength.latest.date)}`:'No sessions','running-records':stats.running.records.length?stats.running.records.map(record=>`${record.label} : ${record.seconds} s (demo)`).join(', '):'Not recorded','strength-exercises':stats.strength.exercises.join(', ')||'Not recorded'};
  Object.entries(data).forEach(([key,value])=>text(`[data-stat="${key}"]`,value));
  text('#stats-year',String(year));text('#stats-scope',`${discipline.toUpperCase()} · DEMO`);text('#graph-summary',`${filtered.length} sessions · ${days.filter(day=>day.minutes>0).length} active days · ${year}`);text('#session-count',`${filtered.length} demo sessions`);
  document.querySelectorAll<HTMLElement>('.journal-entry').forEach(entry=>{entry.hidden=!filtered.some(session=>session.date===entry.dataset.date&&session.sport===entry.dataset.sport);});
  document.querySelector<HTMLElement>('#journal-empty')!.hidden=filtered.length>0;
 }
 buttons.forEach(button=>button.addEventListener('click',()=>{discipline=button.dataset.filter as Discipline;buttons.forEach(b=>b.setAttribute('aria-pressed',String(b===button)));render();}));
 yearSelect.addEventListener('change',()=>{year=Number(yearSelect.value);render();});
 dateInput.addEventListener('change',()=>{if(dateInput.validity.valid&&dateInput.value.startsWith(`${year}-`)&&dateInput.value<=DEMO_TODAY)showDay(dateInput.value);});
 grid.addEventListener('keydown',event=>{
  const target=event.target as HTMLButtonElement;
  if(!target.matches('.contribution-day'))return;
  const delta:Record<string,number>={ArrowUp:-1,ArrowDown:1,ArrowLeft:-7,ArrowRight:7};
  if(!(event.key in delta)&&event.key!=='Home'&&event.key!=='End')return;
  event.preventDefault();const days=Array.from(grid.querySelectorAll<HTMLButtonElement>('.contribution-day:not(:disabled)'));const index=days.indexOf(target);const next=event.key==='Home'?0:event.key==='End'?days.length-1:Math.max(0,Math.min(days.length-1,index+delta[event.key]!));days.forEach(day=>day.tabIndex=-1);if(days[next]){days[next]!.tabIndex=0;days[next]!.focus();}
 });
 render();
</script>
