---
import Layout from '../../layouts/Layout.astro';
import {sessions,fullDateLabel,paceLabel} from '../../lib/data';
export function getStaticPaths(){return sessions.map(session=>({params:{id:session.id},props:{session}}));}
const {session:s}=Astro.props;
---
<Layout title={s.title}><article class="reading"><a href="/training/">← All sessions</a><div class="page-heading"><p class="eyebrow">{fullDateLabel(s.date)} · {s.sport}</p><h1>{s.title}</h1></div><p class="demo-notice">Entirely fictional session, created for the demo.</p><dl class="detail-stats"><div><dt>Duration</dt><dd>{s.minutes} min</dd></div>{s.sport==='Running'&&s.km&&<div><dt>Distance</dt><dd>{s.km.toLocaleString('en-GB')} km</dd></div>}{paceLabel(s)&&<div><dt>Average pace</dt><dd>{paceLabel(s)}</dd></div>}<div><dt>Effort</dt><dd>{s.effort}</dd></div></dl>{s.sport==='Strength'&&<section><h2>Exercises</h2>{s.exercises?.length?<ul class="simple-list">{s.exercises.map(exercise=><li><h3>{exercise.name}</h3><p>{exercise.sets} sets × {exercise.reps?`${exercise.reps} reps`:`${exercise.seconds} seconds`} · {exercise.kg!==undefined?`${exercise.kg} kg`:'weight not recorded'}</p></li>)}</ul>:<p>No exercises recorded.</p>}</section>}{s.note&&<section><h2>Session notes</h2><p class="lead">{s.note}</p></section>}</article></Layout>
