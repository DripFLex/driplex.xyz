---
import Layout from '../../layouts/Layout.astro';
import {sessions,fullDateLabel,paceLabel} from '../../lib/data';
export function getStaticPaths(){return sessions.map(session=>({params:{id:session.id},props:{session}}));}
const {session:s}=Astro.props;
---
<Layout title={s.title}><article class="reading"><a href="/training/">← Toutes les séances</a><div class="page-heading"><p class="eyebrow">{fullDateLabel(s.date)} · {s.sport}</p><h1>{s.title}</h1></div><p class="demo-notice">Séance entièrement fictive, créée pour la démonstration.</p><dl class="detail-stats"><div><dt>Durée</dt><dd>{s.minutes} min</dd></div>{s.sport==='Running'&&s.km&&<div><dt>Distance</dt><dd>{s.km.toLocaleString('fr-BE')} km</dd></div>}{paceLabel(s)&&<div><dt>Allure moyenne</dt><dd>{paceLabel(s)}</dd></div>}<div><dt>Effort</dt><dd>{s.effort}</dd></div></dl>{s.sport==='Strength'&&<section><h2>Exercices</h2>{s.exercises?.length?<ul class="simple-list">{s.exercises.map(exercise=><li><h3>{exercise.name}</h3><p>{exercise.sets} séries × {exercise.reps?`${exercise.reps} répétitions`:`${exercise.seconds} secondes`} · {exercise.kg!==undefined?`${exercise.kg} kg`:'charge non renseignée'}</p></li>)}</ul>:<p>Exercices non renseignés.</p>}</section>}{s.note&&<section><h2>Notes de séance</h2><p class="lead">{s.note}</p></section>}</article></Layout>
