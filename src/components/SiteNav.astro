---
import {
  House,
  UserRound,
  Terminal,
  Activity,
  Clock,
  Camera,
  Map,
  Gamepad2,
  Menu,
  X,
} from '@lucide/astro';
import { navigation } from '../lib/home';
const icons = {
  house: House,
  'user-round': UserRound,
  terminal: Terminal,
  activity: Activity,
  clock: Clock,
  camera: Camera,
  map: Map,
  'gamepad-2': Gamepad2,
};
const active = (href: string) =>
  href === '/' ? Astro.url.pathname === '/' : Astro.url.pathname.startsWith(href);
---

<nav class="side-navigation" aria-label="Main navigation">
  {navigation.map(({ href, label, icon, soon }, index) => {
    const Icon = icons[icon];
    const startsSoonGroup = soon && !navigation[index - 1]?.soon;
    return (
      <>
        {startsSoonGroup && <span class="soon-divider" aria-hidden="true" />}
        <a
          href={href}
          class:list={['side-destination', { 'is-soon': soon }]}
          aria-label={soon ? `${label} (coming soon)` : label}
          aria-current={active(href) ? 'page' : undefined}
        >
          <Icon size={20} stroke-width={1.6} aria-hidden="true" />
          <span class="destination-tooltip" aria-hidden="true">
            {label}
            {soon && <span class="soon-badge">Soon</span>}
          </span>
        </a>
      </>
    );
  })}
</nav>
<details class="mobile-navigation">
  <summary>
    <Menu class="menu-open" size={19} aria-hidden="true" />
    <X class="menu-close" size={19} aria-hidden="true" />
    <span>Menu</span>
  </summary>
  <nav class="mobile-destinations" aria-label="Main navigation on mobile">
    {navigation.map(({ href, label, icon, soon }) => {
      const Icon = icons[icon];
      return (
        <a
          href={href}
          class:list={{ 'is-soon': soon }}
          aria-current={active(href) ? 'page' : undefined}
        >
          <Icon size={19} stroke-width={1.6} aria-hidden="true" />
          <span>{label}</span>
          {soon && <span class="soon-badge">Soon</span>}
          {active(href) && <span class="sr-only"> — current page</span>}
        </a>
      );
    })}
  </nav>
</details>
<script>
  document.querySelectorAll<HTMLDetailsElement>('.mobile-navigation').forEach((menu) => {
    const trigger = menu.querySelector('summary');
    menu.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        menu.open = false;
        trigger?.focus();
        event.preventDefault();
      }
    });
    document.addEventListener('click', (event) => {
      if (menu.open && event.target instanceof Node && !menu.contains(event.target)) {
        const focusWasInside = menu.contains(document.activeElement);
        menu.open = false;
        if (focusWasInside && document.activeElement === document.body) trigger?.focus();
      }
    });
    window.matchMedia('(min-width: 1024px)').addEventListener('change', (event) => {
      if (event.matches) menu.open = false;
    });
  });
</script>
<style>
  .side-navigation {
    position: fixed;
    left: 24px;
    top: 50%;
    transform: translateY(-50%);
    width: 64px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    align-items: center;
    padding: 10px 0;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 34px;
    z-index: 20;
  }
  .side-destination {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    border-radius: 50%;
    color: var(--text-secondary);
    text-decoration: none;
  }
  .side-destination:hover {
    background: var(--surface-secondary);
    color: var(--text);
  }
  .side-destination[aria-current='page'] {
    background: var(--surface-secondary);
    color: var(--interactive);
    box-shadow: inset 0 0 0 1px var(--border);
  }
  .side-destination[aria-current='page']::after {
    content: '';
    position: absolute;
    left: -7px;
    top: 18px;
    width: 3px;
    height: 8px;
    border-radius: 2px;
    background: var(--interactive);
  }
  .destination-tooltip {
    position: absolute;
    left: calc(100% + 22px);
    padding: 8px 11px;
    white-space: nowrap;
    font-size: 12px;
    line-height: 1.4;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--surface-secondary);
    color: var(--text);
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
  }
  .side-destination:hover .destination-tooltip,
  .side-destination:focus-visible .destination-tooltip {
    visibility: visible;
    opacity: 1;
  }
  .soon-divider {
    width: 24px;
    height: 1px;
    margin: 2px 0;
    background: var(--border);
    flex-shrink: 0;
  }
  .side-destination.is-soon:not([aria-current='page']) {
    opacity: 0.55;
  }
  .side-destination.is-soon:hover,
  .side-destination.is-soon:focus-visible {
    opacity: 1;
  }
  .soon-badge {
    margin-left: 8px;
    padding: 1px 6px;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--text-secondary);
  }
  .mobile-navigation {
    display: none;
  }
  @media (max-width: 1023px) {
    .mobile-destinations a.is-soon .soon-badge {
      margin-left: auto;
    }
    .mobile-destinations a.is-soon:not([aria-current='page']) > :global(svg),
    .mobile-destinations a.is-soon:not([aria-current='page']) > span:first-of-type {
      opacity: 0.7;
    }
    .side-navigation {
      display: none;
    }
    .mobile-navigation {
      display: block;
      position: relative;
      z-index: 20;
    }
    .mobile-navigation summary {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      min-height: 44px;
      padding: 10px 13px;
      border: 1px solid var(--border);
      border-radius: 8px;
      background: var(--surface);
      font-size: 12px;
      color: var(--text);
      cursor: pointer;
      list-style: none;
    }
    .mobile-navigation summary::-webkit-details-marker {
      display: none;
    }
    .mobile-navigation summary:focus-visible {
      outline: 2px solid var(--interactive);
      outline-offset: 5px;
    }
    .menu-close {
      display: none;
    }
    .mobile-navigation[open] .menu-close {
      display: block;
    }
    .mobile-navigation[open] .menu-open {
      display: none;
    }
    .mobile-destinations {
      position: absolute;
      right: 0;
      top: calc(100% + 10px);
      width: min(290px, calc(100vw - 36px));
      max-height: calc(100dvh - 100px);
      overflow-y: auto;
      overscroll-behavior: contain;
      scroll-padding-block: 8px;
      padding: 8px;
      border: 1px solid var(--border);
      border-radius: 12px;
      background: var(--surface);
      box-shadow: 0 16px 40px #0006;
    }
    .mobile-destinations a {
      display: flex;
      align-items: center;
      gap: 13px;
      min-height: 46px;
      padding: 11px 14px;
      border-radius: 6px;
      text-decoration: none;
      font-size: 13px;
      color: var(--text-secondary);
    }
    .mobile-destinations a:hover {
      color: var(--text);
      background: var(--surface-secondary);
    }
    .mobile-destinations a[aria-current='page'] {
      color: var(--text);
      background: var(--surface-secondary);
      box-shadow: inset 3px 0 0 var(--interactive);
    }
  }
  @media (min-width: 1024px) and (max-height: 420px) {
    .side-navigation {
      gap: 2px;
      padding-block: 6px;
    }
  }
  @media (min-width: 1024px) and (max-height: 350px) {
    .side-navigation {
      max-height: calc(100dvh - 16px);
      overflow-y: auto;
      overscroll-behavior: contain;
      scroll-padding-block: 6px;
      border-radius: 22px;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .destination-tooltip {
      transition: opacity 0.15s ease;
    }
  }
</style>
