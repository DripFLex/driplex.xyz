---
import { dateLabel } from '../lib/data';
interface Props { title: string; meta: string; description: string; href: string; linkLabel: string; date?: string }
const { title, meta, description, href, linkLabel, date } = Astro.props;
---
<article class="home-entry">
  <p class="entry-meta">{date && <><time datetime={date}>{dateLabel(date)}</time><span aria-hidden="true"> · </span></>}{meta}</p>
  <h3>{title}</h3>
  <p class="entry-description">{description}</p>
  <a href={href}>{linkLabel} <span aria-hidden="true">↗</span><span class="sr-only"> : {title}</span></a>
</article>
<style>
  .home-entry+.home-entry{border-top:1px solid var(--border);padding-top:28px;margin-top:28px}
  .home-entry .entry-meta{font-size:10px;line-height:1.7;letter-spacing:.6px;text-transform:uppercase;color:var(--text-secondary);margin:0 0 14px}
  h3{margin:0 0 12px;font-size:24px;font-weight:400;line-height:1.4;letter-spacing:-.4px;overflow-wrap:break-word}
  .home-entry .entry-description{margin:0 0 9px;font-size:15px;line-height:1.75;color:var(--text-secondary)}
  a{display:inline-flex;align-items:center;gap:5px;min-height:44px;font-size:12px;text-decoration:underline;text-decoration-color:transparent;text-underline-offset:5px}
  a:hover,a:focus-visible{text-decoration-color:currentColor}
  @media(max-width:800px){h3{font-size:22px;line-height:1.4}.home-entry+.home-entry{padding-top:28px;margin-top:24px}.home-entry .entry-meta{font-size:10px;letter-spacing:.4px}.home-entry .entry-description{font-size:15px}}
</style>
