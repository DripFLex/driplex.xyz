---
import {dateLabel, type Session} from '../lib/data';
interface Props { session:Session }
const {session:s}=Astro.props;
---
<article class="session" data-sport={s.sport}>
 <div class:list={['sport-icon',s.sport.toLowerCase()]} aria-hidden="true">{s.sport==='Running'?'↗':'↔'}</div>
 <div class="session-body"><p class="eyebrow">{dateLabel(s.date)} · {s.sport} · Fictif</p><h3><a href={`/training/${s.id}/`}>{s.title}</a></h3><p>{s.effort} <span aria-hidden="true">·</span> {s.minutes} min {s.km>0&&`· ${s.km.toLocaleString('fr-BE')} km`}</p></div><a class="arrow" href={`/training/${s.id}/`} aria-label={`Voir ${s.title}`}>↗</a>
</article>
