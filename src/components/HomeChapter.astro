---
interface Props { id: string; label: string; title: string; compact?: boolean }
const { id, label, title, compact = false } = Astro.props;
---
<section class:list={['home-chapter', { 'chapter-compact': compact }]} aria-labelledby={id}>
  <header class="chapter-margin"><p class="chapter-label">{label}</p><h2 id={id}>{title}</h2></header>
  <div class="chapter-content"><slot /></div>
</section>
<style>
  .home-chapter{display:grid;grid-template-columns:260px minmax(0,1fr);gap:70px;padding:64px 0;border-bottom:1px solid var(--border)}
  .chapter-margin,.chapter-content{min-width:0}
  .chapter-label{margin:0 0 22px;font-size:10px;line-height:1.7;letter-spacing:1.3px;color:var(--text-secondary)}
  h2{margin:0;font-size:42px;font-weight:400;line-height:1.25;letter-spacing:-.8px;white-space:pre-line;overflow-wrap:break-word}
  .chapter-compact h2{font-size:32px}
  .chapter-content :global(p){font-size:15px;line-height:1.75;color:var(--text-secondary);margin:0 0 20px}
  .chapter-content :global(.chapter-link){display:inline-flex;align-items:center;min-height:44px;font-size:12px;text-decoration:underline;text-decoration-color:var(--border);text-underline-offset:5px}
  .chapter-content :global(.chapter-link:hover),.chapter-content :global(.chapter-link:focus-visible){text-decoration-color:currentColor}
  @media(max-width:1023px){.home-chapter{grid-template-columns:220px minmax(0,1fr);gap:40px}}
  @media(max-width:800px){.home-chapter{display:block;padding:40px 0}.chapter-margin{margin-bottom:28px}.chapter-label{margin-bottom:14px}.home-chapter h2{font-size:28px;line-height:1.35;white-space:normal;letter-spacing:-.6px}.chapter-content :global(p){font-size:15px;line-height:1.75}.chapter-content :global(.chapter-link){font-size:12px}}
</style>
